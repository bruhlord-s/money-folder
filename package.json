{
  "name": "money-folder",
  "version": "0.0.0",
  "description": "A family budget: accounts, expenses with receipt lines, income and transfers",
  "main": "./out/main/index.js",
  "author": "Treize Konstantin <treizeknstntn@gmail.com>",
  "homepage": "https://github.com/bruhlord-s/money-folder",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "knip": "knip",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "test": "pnpm run test:main && pnpm run test:renderer",
    "test:main": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run --project main",
    "test:renderer": "vitest run --project renderer",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "pnpm run build && electron-builder --mac",
    "build:linux": "pnpm run build && electron-builder --linux",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "electron-log": "^5.4.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@electron-toolkit/eslint-config-prettier": "3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@primeuix/themes": "^2.0.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.2",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.6.2",
    "knip": "^6.40.0",
    "lefthook": "^2.1.16",
    "prettier": "^3.7.4",
    "primeicons": "^7.0.0",
    "primevue": "~4.5.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.2.6",
    "vitest": "^5.0.3",
    "vue": "^3.5.25",
    "vue-eslint-parser": "^10.2.0",
    "vue-i18n": "^11.4.13",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.1.6"
  },
  "packageManager": "pnpm@12.8.1"
}
